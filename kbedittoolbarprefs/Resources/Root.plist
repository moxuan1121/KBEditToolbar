<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>独立布局调整</string>
            <key>footerText</key>
            <string>默认以地球和麦克风为两端，把四个工具按钮插入中间，六个按钮整体等距。每个工具按钮的 X、Y 偏移独立保存；X 负值向左、正值向右，Y 负值向上、正值向下。返回使用键盘的 App 后生效。</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>粘贴按钮</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>label</key><string>X：左右</string>
            <key>defaults</key><string>cn.example.kbedittoolbar.preferences</string>
            <key>key</key><string>pasteX</string>
            <key>default</key><real>0</real>
            <key>min</key><real>-500</real>
            <key>max</key><real>500</real>
            <key>showValue</key><true/>
            <key>isSegmented</key><true/>
            <key>segmentCount</key><integer>200</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>label</key><string>Y：上下</string>
            <key>defaults</key><string>cn.example.kbedittoolbar.preferences</string>
