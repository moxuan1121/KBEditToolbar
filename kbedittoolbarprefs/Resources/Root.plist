            <string>PSGroupCell</string>
            <key>label</key>
            <string>收起键盘按钮</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string><key>label</key><string>SF Symbol</string>
            <key>defaults</key><string>.GlobalPreferences</string><key>key</key><string>KBETDismissSymbol</string>
            <key>default</key><string>keyboard.chevron.compact.down</string>
