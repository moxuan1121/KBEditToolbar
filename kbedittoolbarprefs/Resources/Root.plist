<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>独立布局调整</string>
            <key>footerText</key>
            <string>默认以地球和麦克风为两端，把四个工具按钮插入中间，六个按钮整体等距。每个工具按钮的 X、Y 偏移独立保存；X 负值向左、正值向右，Y 负值向上、正值向下。返回使用键盘的 App 后生效。</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>颜色</string>
            <key>footerText</key><string>默认跟随系统地球键的实际颜色。关闭后可用系统取色器或十六进制色值 DIY。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>跟随地球键颜色</string>
            <key>defaults</key><string>.GlobalPreferences</string>
            <key>key</key><string>KBETFollowSystemTint</string>
            <key>default</key><true/>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>自定义颜色</string>
            <key>id</key><string>customTintHex</string>
            <key>defaults</key><string>.GlobalPreferences</string>
            <key>key</key><string>KBETCustomTintHex</string>
            <key>default</key><string>#000000</string>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>打开系统取色器</string>
            <key>action</key><string>openColorPicker</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>按压区域与辅助线</string>
            <key>footerText</key><string>宽高可输入到小数点后一位。开启阴影可查看四个按钮的真实按压区域，调整完成后可手动关闭。辅助线包含一条高度横线和六条等距竖线。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string><key>label</key><string>按压区域宽度</string>
            <key>defaults</key><string>.GlobalPreferences</string><key>key</key><string>KBETTouchWidth</string>
            <key>default</key><real>60</real><key>keyboardType</key><integer>8</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string><key>label</key><string>按压区域高度</string>
            <key>defaults</key><string>.GlobalPreferences</string><key>key</key><string>KBETTouchHeight</string>
            <key>default</key><real>44</real><key>keyboardType</key><integer>8</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string><key>label</key><string>显示按压区域阴影</string>
            <key>defaults</key><string>.GlobalPreferences</string><key>key</key><string>KBETShowTouchShadow</string>
            <key>default</key><false/>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string><key>label</key><string>显示布局辅助线</string>
            <key>defaults</key><string>.GlobalPreferences</string><key>key</key><string>KBETShowLayoutGuides</string>
            <key>default</key><false/>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>长按设置</string>
            <key>footerText</key>
            <string>单位为毫秒，默认 500 ms。本版本不设置输入上限或下限；负数在运行时按 0 ms 处理。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>长按时长（ms）</string>
            <key>defaults</key><string>.GlobalPreferences</string>
            <key>key</key><string>KBETLongPressDurationMS</string>
            <key>default</key><string>500</string>
            <key>keyboardType</key><integer>4</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>粘贴按钮</string>
        </dict>
        <dict>
