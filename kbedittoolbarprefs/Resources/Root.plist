            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>X：左右</string>
            <key>defaults</key><string>.GlobalPreferences</string>
            <key>key</key><string>KBETPasteX</string>
            <key>default</key><real>0</real>
            <key>keyboardType</key><integer>2</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>Y：上下</string>
            <key>defaults</key><string>.GlobalPreferences</string>
            <key>key</key><string>KBETPasteY</string>
            <key>default</key><real>0</real>
            <key>keyboardType</key><integer>2</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>向左按钮</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string><key>label</key><string>SF Symbol</string>
            <key>defaults</key><string>.GlobalPreferences</string><key>key</key><string>KBETLeftSymbol</string>
            <key>default</key><string>arrow.left.circle</string>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string><key>label</key><string>图标大小</string>
            <key>defaults</key><string>.GlobalPreferences</string><key>key</key><string>KBETLeftIconPointSize</string>
            <key>default</key><real>22</real><key>keyboardType</key><integer>8</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>X：左右</string>
            <key>defaults</key><string>.GlobalPreferences</string>
            <key>key</key><string>KBETLeftX</string>
            <key>default</key><real>0</real>
            <key>keyboardType</key><integer>2</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>Y：上下</string>
            <key>defaults</key><string>.GlobalPreferences</string>
            <key>key</key><string>KBETLeftY</string>
            <key>default</key><real>0</real>
            <key>keyboardType</key><integer>2</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>向右按钮</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string><key>label</key><string>SF Symbol</string>
            <key>defaults</key><string>.GlobalPreferences</string><key>key</key><string>KBETRightSymbol</string>
            <key>default</key><string>arrow.right.circle</string>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string><key>label</key><string>图标大小</string>
            <key>defaults</key><string>.GlobalPreferences</string><key>key</key><string>KBETRightIconPointSize</string>
            <key>default</key><real>22</real><key>keyboardType</key><integer>8</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>X：左右</string>
            <key>defaults</key><string>.GlobalPreferences</string>
            <key>key</key><string>KBETRightX</string>
            <key>default</key><real>0</real>
            <key>keyboardType</key><integer>2</integer>
            <key>PostNotification</key><string>cn.example.kbedittoolbar/preferencesChanged</string>
