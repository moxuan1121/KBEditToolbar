        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>恢复默认会清除颜色、按压区域、阴影、辅助线、独立偏移、SF Symbol、各图标大小及长按时长设置。</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>恢复默认布局</string>
            <key>action</key>
            <string>resetLayout</string>
        </dict>
    </array>
    <key>title</key>
    <string>键盘编辑工具条</string>
</dict>
</plist>
